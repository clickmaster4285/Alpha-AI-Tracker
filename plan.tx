MOD: server/internal/config/config.go, .env, .env.example, models/app_session.go, dto/new_schema_dto.go, services/new_schema_service.go, repository/new_schema_repo.go, cmd/server/main.go
MOD: client/Storage/DatabaseSchema.cs, client/Services/LogCollectorService.cs
