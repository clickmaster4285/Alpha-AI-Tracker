# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=alpha_ai
DB_PASSWORD=alpha_ai_secret
DB_NAME=alpha_ai_tracker
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# JWT Authentication
JWT_SECRET=change-this-to-a-very-long-random-secret-key
JWT_ACCESS_EXPIRY=24h

# Company Admin (auto-initialized on first run)
ADMIN_EMAIL=admin@alphai.com
ADMIN_PASSWORD=AlphaAI@2024!
ADMIN_NAME=Company Admin

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
