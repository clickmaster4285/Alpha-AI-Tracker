<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  GuardianConnect Enterprise Security Suite — Light Theme           -->
    <!--  Recreated 1:1 from visily_client_design.pdf                       -->
    <!--  Palette: #F8F9FA canvas / white cards / #2563EB enterprise blue  -->
    <!--           / #0EA5E9 cyan accent / #0F172A navy cards              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Colors -->
    <Color x:Key="BgColor">#F4F6FA</Color>
    <Color x:Key="CanvasColor">#F8F9FA</Color>
    <Color x:Key="FgColor">#0F172A</Color>
    <Color x:Key="MutedFgColor">#64748B</Color>
    <Color x:Key="FaintFgColor">#94A3B8</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="CardFgColor">#1E293B</Color>
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>
    <Color x:Key="PrimaryPressedColor">#1E40AF</Color>
    <Color x:Key="PrimaryFgColor">#FFFFFF</Color>
    <Color x:Key="SecondaryColor">#0EA5E9</Color>
    <Color x:Key="SecondaryFgColor">#FFFFFF</Color>
    <Color x:Key="NavyColor">#0F172A</Color>
    <Color x:Key="NavyFgColor">#E2E8F0</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessFgColor">#FFFFFF</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningFgColor">#78350F</Color>
    <Color x:Key="DestructiveColor">#DC2626</Color>
    <Color x:Key="DestructiveFgColor">#FFFFFF</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="InfoFgColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="MutedBrushColor">#F1F5F9</Color>
    <Color x:Key="InputColor">#FFFFFF</Color>
    <Color x:Key="RingColor">#2563EB</Color>
    <Color x:Key="TrackColor">#E2E8F0</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}"/>
    <SolidColorBrush x:Key="MutedFgBrush" Color="{StaticResource MutedFgColor}"/>
    <SolidColorBrush x:Key="FaintFgBrush" Color="{StaticResource FaintFgColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardFgBrush" Color="{StaticResource CardFgColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="PrimaryFgBrush" Color="{StaticResource PrimaryFgColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryFgBrush" Color="{StaticResource SecondaryFgColor}"/>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}"/>
    <SolidColorBrush x:Key="NavyFgBrush" Color="{StaticResource NavyFgColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessFgBrush" Color="{StaticResource SuccessFgColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningFgBrush" Color="{StaticResource WarningFgColor}"/>
    <SolidColorBrush x:Key="DestructiveBrush" Color="{StaticResource DestructiveColor}"/>
    <SolidColorBrush x:Key="DestructiveFgBrush" Color="{StaticResource DestructiveFgColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoFgBrush" Color="{StaticResource InfoFgColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedBrushColor}"/>
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}"/>
    <SolidColorBrush x:Key="RingBrush" Color="{StaticResource RingColor}"/>
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- Shadows (Avalonia: offsetX offsetY blur spread color) -->
    <BoxShadows x:Key="CardShadow">0 2 8 0 #0F172A14</BoxShadows>
    <BoxShadows x:Key="ShadowLg">0 8 24 0 #0F172A26</BoxShadows>
    <BoxShadows x:Key="ShadowSm">0 1 3 0 #0F172A0D</BoxShadows>

    <!-- Radii -->
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusXl">20</CornerRadius>

    <!-- Fonts -->
    <FontFamily x:Key="DisplayFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="BodyFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

</ResourceDictionary>
