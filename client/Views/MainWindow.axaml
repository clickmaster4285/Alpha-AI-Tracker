<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:client.Converters"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="640"
        x:Class="client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Alpha AI Tracker"
        WindowStartupLocation="CenterScreen"
        MinWidth="400" MinHeight="480"
        Width="480" Height="640"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">

    <Window.Resources>
        <conv:BoolInvertConverter x:Key="BoolInvert" />
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <conv:LoadingToTextConverter x:Key="LoadingToText" />
    </Window.Resources>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <!-- ════════════════════════════════════════════════ -->
        <!--  SECTION 1: LOGIN (shown when not logged in)   -->
        <!-- ════════════════════════════════════════════════ -->
        <Border IsVisible="{Binding IsLoggedIn, Converter={StaticResource BoolInvert}}"
                Background="{StaticResource BgBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="360" Spacing="14" Margin="32,48">

                    <!-- Logo -->
                    <Border Background="{StaticResource PrimaryBrush}"
                            CornerRadius="{StaticResource RadiusLg}"
                            Width="56" Height="56"
                            HorizontalAlignment="Center"
                            BoxShadow="{StaticResource CardShadow}">
                        <TextBlock Text="AI" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryFgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Alpha AI Tracker" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource FgBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Employee Login" FontSize="14"
                               Foreground="{StaticResource MutedFgBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>

                    <TextBlock Text="Employee ID" FontSize="12"
                               Foreground="{StaticResource MutedFgBrush}"/>
                    <TextBox Text="{Binding EmployeeId}" PlaceholderText="e.g. EMP-10001"/>

                    <TextBlock Text="Secret Key" FontSize="12"
                               Foreground="{StaticResource MutedFgBrush}"/>
                    <TextBox Text="{Binding SecretKey}" PlaceholderText="Enter your secret key"/>

                    <!-- Error / status message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource DestructiveBrush}" FontSize="12"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}"/>

                    <!-- Login button -->
                    <Button Classes="primary"
                            Command="{Binding LoginCommand}"
                            HorizontalAlignment="Stretch" Height="44"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInvert}}"
                            Content="{Binding IsLoading, Converter={StaticResource LoadingToText}}"
                            Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ════════════════════════════════════════════════ -->
        <!--  SECTION 2: LOGGED IN — Steps or Profile        -->
        <!-- ════════════════════════════════════════════════ -->
        <Border IsVisible="{Binding IsLoggedIn}" Background="{StaticResource BgBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,*" Margin="24,32">

                    <Border IsVisible="{Binding RequiresPermissionAction}"
                            Background="{StaticResource CardBrush}"
                            CornerRadius="{StaticResource RadiusLg}"
                            Padding="14,10"
                            HorizontalAlignment="Center" Margin="0,0,0,24"
                            BoxShadow="{StaticResource CardShadow}">
                        <TextBlock FontSize="13" Foreground="{StaticResource MutedFgBrush}"
                                   HorizontalAlignment="Center">
                            <Run Text="Step "/>
                            <Run Text="{Binding CurrentPermissionStepNumber}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding TotalPermissionSteps}"/>
                        </TextBlock>
                    </Border>

                    <!-- Content area -->
                    <Grid Grid.Row="1">

                        <!-- ── Step 1: Auto-Start ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsAutoStartStep}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="14">
                                <Border Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Width="48" Height="48" HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <TextBlock Text="1" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StepDescription}" FontSize="13"
                                           Foreground="{StaticResource MutedFgBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <Button Classes="primary"
                                        Command="{Binding GrantCurrentStepPermissionCommand}"
                                        IsEnabled="{Binding IsStepWorking, Converter={StaticResource BoolInvert}}"
                                        Content="{Binding StepButtonText}"
                                        HorizontalAlignment="Center" MinWidth="200" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding StepStatusText}" FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Step 2: Background Guard ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsBackgroundStep}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="14">
                                <Border Background="{StaticResource InfoBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Width="48" Height="48" HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <TextBlock Text="2" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource InfoFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StepDescription}" FontSize="13"
                                           Foreground="{StaticResource MutedFgBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <Button Classes="success"
                                        Command="{Binding GrantCurrentStepPermissionCommand}"
                                        IsEnabled="{Binding IsStepWorking, Converter={StaticResource BoolInvert}}"
                                        Content="{Binding StepButtonText}"
                                        HorizontalAlignment="Center" MinWidth="200" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding StepStatusText}" FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Step 3: Dependencies (Linux Only) ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsDependencyStep}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="14">
                                <Border Background="{StaticResource WarningBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Width="48" Height="48" HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <TextBlock Text="3" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource WarningFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StepDescription}" FontSize="13"
                                           Foreground="{StaticResource MutedFgBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding MissingDependenciesList}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource DestructiveBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center" Margin="0,4,0,4"/>
                                <Button Classes="primary"
                                        Command="{Binding GrantCurrentStepPermissionCommand}"
                                        IsEnabled="{Binding IsStepWorking, Converter={StaticResource BoolInvert}}"
                                        Content="Install Automatically"
                                        HorizontalAlignment="Center" MinWidth="200" Margin="0,8,0,0"/>
                                <Button Classes="secondary"
                                        Command="{Binding ShowManualInstallCommand}"
                                        Content="Install Manually"
                                        HorizontalAlignment="Center" MinWidth="200"/>
                                <TextBox Text="{Binding StepStatusText}" FontSize="12" IsReadOnly="True"
                                         Foreground="{StaticResource MutedFgBrush}" Background="Transparent"
                                         HorizontalAlignment="Stretch" TextWrapping="Wrap" BorderThickness="0"
                                         IsVisible="{Binding StepStatusText, Converter={StaticResource StringNotEmpty}}"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Step 4: Other Permissions ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsPermissionStep}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="14">
                                <Border Background="{StaticResource WarningBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Width="48" Height="48" HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <TextBlock Text="{Binding CurrentPermissionStepNumber}" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource WarningFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StepDescription}" FontSize="13"
                                           Foreground="{StaticResource MutedFgBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <Button Classes="primary"
                                        Command="{Binding GrantCurrentStepPermissionCommand}"
                                        IsEnabled="{Binding IsStepWorking, Converter={StaticResource BoolInvert}}"
                                        Content="{Binding StepButtonText}"
                                        HorizontalAlignment="Center" MinWidth="200" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding StepStatusText}" FontSize="12"
                                           Foreground="{StaticResource MutedFgBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Browser Journey Tracking (accessibility-based, automatic) ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsBrowserTracking}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="12" Margin="0,8,0,0">
                                <Border Background="{StaticResource InfoBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Width="48" Height="48" HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <TextBlock Text="🌐" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Browser Journey Tracking" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Browser activity is captured automatically via the OS accessibility tree (AT-SPI / UIA / macOS Accessibility). No debugger, no extension, and no manual setup required."
                                           FontSize="13" Foreground="{StaticResource MutedFgBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding BrowserTrackingStatus}" FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           IsVisible="{Binding BrowserTrackingStatus, Converter={StaticResource StringNotEmpty}}"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Profile (all permissions granted) ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsProfile}">
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="16" Margin="0,8,0,0">
                                <!-- Avatar -->
                                <Border Background="{Binding EmployeeAvatarColor}"
                                        CornerRadius="36" Width="72" Height="72"
                                        HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource ShadowLg}">
                                    <TextBlock Text="{Binding EmployeeAvatar}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="{Binding EmployeeName}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>

                                <!-- Info card -->
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource RadiusLg}" Padding="16"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Department" FontSize="12"
                                                       Foreground="{StaticResource MutedFgBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EmployeeDepartment}"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="{StaticResource FgBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}"/>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Role" FontSize="12"
                                                       Foreground="{StaticResource MutedFgBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EmployeeRole}"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="{StaticResource FgBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button Classes="danger"
                                        Command="{Binding LogoutCommand}"
                                        HorizontalAlignment="Center" Width="160" Margin="0,8,0,0"
                                        Content="Disconnect"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>