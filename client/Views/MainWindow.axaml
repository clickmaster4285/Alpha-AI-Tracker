<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:client.Converters"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="640"
        x:Class="client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Alpha AI Tracker"
        WindowStartupLocation="CenterScreen"
        MinWidth="400" MinHeight="480"
        Width="480" Height="640"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">

    <Window.Resources>
        <conv:BoolInvertConverter x:Key="BoolInvert" />
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <conv:LoadingToTextConverter x:Key="LoadingToText" />
    </Window.Resources>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <!-- ════════════════════════════════════════════════ -->
        <!--  SECTION 1: LOGIN (shown when not logged in)   -->
        <!-- ════════════════════════════════════════════════ -->
        <Border IsVisible="{Binding IsLoggedIn, Converter={StaticResource BoolInvert}}"
                Background="{StaticResource BgBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="360" Spacing="14" Margin="32,48">

                    <!-- Logo -->
                    <Border Background="{StaticResource PrimaryBrush}"
                            CornerRadius="{StaticResource RadiusLg}"
                            Width="56" Height="56"
                            HorizontalAlignment="Center"
                            BoxShadow="{StaticResource CardShadow}">
                        <TextBlock Text="AI" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryFgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Alpha AI Tracker" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource FgBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Employee Login" FontSize="14"
                               Foreground="{StaticResource MutedFgBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>

                    <TextBlock Text="Employee ID" FontSize="12"
                               Foreground="{StaticResource MutedFgBrush}"/>
                    <TextBox Text="{Binding EmployeeId}" PlaceholderText="e.g. EMP-10001"
                             Watermark="e.g. EMP-10001"/>

                    <TextBlock Text="Secret Key" FontSize="12"
                               Foreground="{StaticResource MutedFgBrush}"/>
                    <TextBox Text="{Binding SecretKey}" PlaceholderText="Enter your secret key"
                             Watermark="Enter your secret key"/>

                    <!-- Error / status message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource DestructiveBrush}" FontSize="12"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}"/>

                    <!-- Login button -->
                    <Button Classes="primary"
                            Command="{Binding LoginCommand}"
                            HorizontalAlignment="Stretch" Height="44"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInvert}}"
                            Content="{Binding IsLoading, Converter={StaticResource LoadingToText}}"
                            Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ════════════════════════════════════════════════ -->
        <!--  SECTION 2: LOGGED IN — Steps or Profile        -->
        <!-- ════════════════════════════════════════════════ -->
        <Border IsVisible="{Binding IsLoggedIn}" Background="{StaticResource BgBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,*" Margin="24,32">

                    <Border IsVisible="{Binding RequiresPermissionAction}"
                            Background="{StaticResource CardBrush}"
                            CornerRadius="{StaticResource RadiusLg}"
                            Padding="16,12"
                            HorizontalAlignment="Stretch" Margin="0,0,0,20"
                            BoxShadow="{StaticResource CardShadow}">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedFgBrush}"
                                       HorizontalAlignment="Center">
                                <Run Text="Setup · Step "/>
                                <Run Text="{Binding CurrentPermissionStepNumber}"/>
                                <Run Text=" of "/>
                                <Run Text="{Binding TotalPermissionSteps}"/>
                            </TextBlock>
                            <ProgressBar Minimum="0"
                                         Maximum="{Binding TotalPermissionSteps}"
                                         Value="{Binding CurrentPermissionStepNumber}"
                                         Height="6"
                                         Foreground="{StaticResource PrimaryBrush}"
                                         Background="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Content area -->
                    <Grid Grid.Row="1">

                        <!-- ── Step 1: Auto-Start ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsAutoStartStep}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="14">
                                <Border Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Width="48" Height="48" HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <TextBlock Text="1" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StepDescription}" FontSize="13"
                                           Foreground="{StaticResource MutedFgBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <Button Classes="primary"
                                        Command="{Binding GrantCurrentStepPermissionCommand}"
                                        IsEnabled="{Binding IsStepWorking, Converter={StaticResource BoolInvert}}"
                                        Content="{Binding StepButtonText}"
                                        HorizontalAlignment="Center" MinWidth="200" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding StepStatusText}" FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Step 2: Background Guard ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsBackgroundStep}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="14">
                                <Border Background="{StaticResource InfoBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Width="48" Height="48" HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <TextBlock Text="2" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource InfoFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StepDescription}" FontSize="13"
                                           Foreground="{StaticResource MutedFgBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <Button Classes="success"
                                        Command="{Binding GrantCurrentStepPermissionCommand}"
                                        IsEnabled="{Binding IsStepWorking, Converter={StaticResource BoolInvert}}"
                                        Content="{Binding StepButtonText}"
                                        HorizontalAlignment="Center" MinWidth="200" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding StepStatusText}" FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Step 3: Dependencies (Linux Only) ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsDependencyStep}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="14">
                                <Border Background="{StaticResource WarningBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Width="48" Height="48" HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <TextBlock Text="3" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource WarningFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StepDescription}" FontSize="13"
                                           Foreground="{StaticResource MutedFgBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding MissingDependenciesList}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource DestructiveBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center" Margin="0,4,0,4"/>
                                <Button Classes="primary"
                                        Command="{Binding GrantCurrentStepPermissionCommand}"
                                        IsEnabled="{Binding IsStepWorking, Converter={StaticResource BoolInvert}}"
                                        Content="Install Automatically"
                                        HorizontalAlignment="Center" MinWidth="200" Margin="0,8,0,0"/>
                                <Button Classes="secondary"
                                        Command="{Binding ShowManualInstallCommand}"
                                        Content="Install Manually"
                                        HorizontalAlignment="Center" MinWidth="200"/>
                                <TextBox Text="{Binding StepStatusText}" FontSize="12" IsReadOnly="True"
                                         Foreground="{StaticResource MutedFgBrush}" Background="Transparent"
                                         HorizontalAlignment="Stretch" TextWrapping="Wrap" BorderThickness="0"
                                         IsVisible="{Binding StepStatusText, Converter={StaticResource StringNotEmpty}}"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Step 4: Other Permissions ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsPermissionStep}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="14">
                                <Border Background="{StaticResource WarningBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Width="48" Height="48" HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <TextBlock Text="{Binding CurrentPermissionStepNumber}" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource WarningFgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StepDescription}" FontSize="13"
                                           Foreground="{StaticResource MutedFgBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <Button Classes="primary"
                                        Command="{Binding GrantCurrentStepPermissionCommand}"
                                        IsEnabled="{Binding IsStepWorking, Converter={StaticResource BoolInvert}}"
                                        Content="{Binding StepButtonText}"
                                        HorizontalAlignment="Center" MinWidth="200" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding StepStatusText}" FontSize="12"
                                           Foreground="{StaticResource MutedFgBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Browser Extension Setup ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsBrowserSetup}">
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center"
                                        MaxWidth="400" Spacing="12" Margin="0,8,0,0">
                                <Border Background="{StaticResource InfoBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Width="52" Height="52" HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <TextBlock Text="🌐" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Browser Journey Tracking" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Detected browsers are grouped by engine (Chromium / Gecko / WebKit). New browsers: Refresh then Install. New profiles: Install / Setup All again (idempotent). WebKit is not supported."
                                           FontSize="13" Foreground="{StaticResource MutedFgBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"/>

                                <Button Classes="success"
                                        Command="{Binding OneClickSetupAllCommand}"
                                        IsEnabled="{Binding IsStepWorking, Converter={StaticResource BoolInvert}}"
                                        Content="Setup All Supported Browsers"
                                        HorizontalAlignment="Center" MinWidth="240" Padding="16,10"
                                        FontSize="13" Margin="0,2,0,0"/>

                                <ItemsControl ItemsSource="{Binding DetectedBrowsers}"
                                              Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="14,12" Margin="0,0,0,8"
                                                    BoxShadow="{StaticResource CardShadow}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource FgBrush}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Border Background="{StaticResource SecondaryBrush}"
                                                                    CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{Binding EngineText}" FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource SecondaryFgBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       Foreground="{StaticResource MutedFgBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding StatusLine}" FontSize="10"
                                                                   Foreground="{StaticResource MutedFgBrush}"
                                                                   Opacity="0.85"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Grid.RowSpan="2"
                                                            Content="{Binding ActionButtonText}"
                                                            IsEnabled="{Binding CanInstall}"
                                                            Classes="primary"
                                                            FontSize="12" Padding="12,8"
                                                            MinWidth="120"
                                                            Command="{Binding $parent[ItemsControl].DataContext.AddExtensionToBrowserCommand}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border IsVisible="{Binding HasInstructions}"
                                        Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Padding="16" Margin="0,4,0,0"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding ExtensionInstructionsTitle}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource FgBrush}"
                                                   TextWrapping="Wrap"/>
                                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding ExtensionInstructions}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedFgBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding StepStatusText}" FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           IsVisible="{Binding StepStatusText, Converter={StaticResource StringNotEmpty}}"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,0">
                                    <Button Classes="secondary"
                                            Command="{Binding RefreshBrowsersCommand}"
                                            Content="Refresh Browsers"
                                            IsEnabled="{Binding IsStepWorking, Converter={StaticResource BoolInvert}}"
                                            FontSize="12" Padding="14,8"/>
                                    <Button Classes="success"
                                            Command="{Binding DismissBrowserSetupCommand}"
                                            Content="Continue to Profile"
                                            FontSize="12" Padding="14,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Profile (all permissions granted) ── -->
                        <Border Classes="fade-in" IsVisible="{Binding IsProfile}">
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center"
                                        MaxWidth="360" Spacing="16" Margin="0,8,0,0">
                                <!-- Avatar -->
                                <Border Background="{Binding EmployeeAvatarColor}"
                                        CornerRadius="36" Width="72" Height="72"
                                        HorizontalAlignment="Center"
                                        BoxShadow="{StaticResource ShadowLg}">
                                    <TextBlock Text="{Binding EmployeeAvatar}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="{Binding EmployeeName}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource FgBrush}"
                                           HorizontalAlignment="Center"/>

                                <!-- Info card -->
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource RadiusLg}" Padding="16"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Department" FontSize="12"
                                                       Foreground="{StaticResource MutedFgBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EmployeeDepartment}"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="{StaticResource FgBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}"/>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Role" FontSize="12"
                                                       Foreground="{StaticResource MutedFgBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EmployeeRole}"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="{StaticResource FgBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Pending setup / missing permissions -->
                                <Border IsVisible="{Binding HasPendingSetup}"
                                        Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource RadiusLg}" Padding="14"
                                        BorderBrush="{StaticResource WarningBrush}"
                                        BorderThickness="1"
                                        BoxShadow="{StaticResource CardShadow}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Setup incomplete"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource FgBrush}"/>
                                        <TextBlock Text="These items still need attention. Tap Fix to reopen that step."
                                                   FontSize="11" Foreground="{StaticResource MutedFgBrush}"
                                                   TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding SetupChecklist}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource MutedBrush}"
                                                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource FgBrush}"/>
                                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                                           Foreground="{StaticResource MutedFgBrush}"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Content="{Binding ActionLabel}"
                                                                    Classes="primary" FontSize="11"
                                                                    Padding="10,6"
                                                                    Command="{Binding $parent[ItemsControl].DataContext.FixSetupItemCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Button Classes="danger"
                                        Command="{Binding LogoutCommand}"
                                        HorizontalAlignment="Center" Width="160" Margin="0,8,0,0"
                                        Content="Disconnect"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>