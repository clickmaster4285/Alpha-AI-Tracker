<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:client.ViewModels"
        xmlns:pages="using:client.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:client.Converters"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding AppTitleWithVersion}"
        WindowStartupLocation="CenterScreen"
        MinWidth="1000" MinHeight="660"
        Width="1280" Height="800"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource FgBrush}">

    <!-- ═══ SHELL ════════════════════════════════════════════════════════════
         Three mutually exclusive top-level states, then a nav rail hosting
         pages 4–6. Every page lives in Views/Pages as its own UserControl so
         this file stays a router, not a monolith.

           IsSplashVisible          → page 1  SplashPage
           !IsLoggedIn              → page 2  LoginPage
           RequiresPermissionAction → page 3  PermissionSetupPage
           IsProfile                → pages 4–6 behind the rail

         All brand strings come from AppInfo (client/APP_IDENTIFIERS +
         client/VERSION); nothing here is hardcoded.
    ═══════════════════════════════════════════════════════════════════════ -->

    <Window.Resources>
        <conv:BoolInvertConverter x:Key="BoolInvert" />
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <conv:LoadingToTextConverter x:Key="LoadingToText" />
        <conv:PercentToGridLengthConverter x:Key="PercentToGridLength" />
    </Window.Resources>

    <Grid>

        <!-- ── Page 1 — splash ── -->
        <pages:SplashPage IsVisible="{Binding IsSplashVisible}"/>

        <Grid IsVisible="{Binding !IsSplashVisible}">

            <!-- ── Page 2 — login ── -->
            <pages:LoginPage IsVisible="{Binding !IsLoggedIn}"/>

            <!-- ── Page 3 — permission wizard ── -->
            <pages:PermissionSetupPage IsVisible="{Binding RequiresPermissionAction}"/>

            <!-- ── Pages 4–6 — main shell ── -->
            <Grid IsVisible="{Binding IsProfile}" ColumnDefinitions="246,*">

                <!-- ══ Nav rail ══ -->
                <Border Grid.Column="0" Background="{StaticResource RailBrush}"
                        BorderBrush="{StaticResource RailBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">

                        <!-- Brand -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                                    Margin="18,24,18,22">
                            <Border Width="40" Height="40" CornerRadius="12"
                                    Background="{StaticResource PrimaryBrush}">
                                <Grid>
                                    <Path Data="{StaticResource ShieldGeometry}"
                                          Fill="White" Stretch="Uniform"
                                          Width="21" Height="21" Opacity="0.28"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AppInitials}"
                                               Foreground="White" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding AppDisplayName}"
                                           Foreground="{StaticResource RailFgActiveBrush}"
                                           FontSize="14.5" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AppTagline}"
                                           Foreground="{StaticResource RailFgBrush}"
                                           FontSize="8.5" LetterSpacing="1.1"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Grid.Row="1" Height="1"
                                   Fill="{StaticResource RailBorderBrush}" Margin="14,0"/>

                        <!-- Nav items -->
                        <StackPanel Grid.Row="2" Margin="12,20,12,0" Spacing="4">

                            <Button Classes="nav" Classes.active="{Binding IsDashboardPage}"
                                    Command="{Binding NavigateCommand}" CommandParameter="dashboard">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <Path Data="{StaticResource GaugeGeometry}"
                                          StrokeThickness="1.7" StrokeLineCap="Round"
                                          Stretch="Uniform" Width="17" Height="17"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Overview" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="nav" Classes.active="{Binding IsSystemSpecsPage}"
                                    Command="{Binding NavigateCommand}" CommandParameter="specs">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <Path Data="{StaticResource ChipGeometry}"
                                          StrokeThickness="1.5" StrokeLineCap="Round"
                                          Stretch="Uniform" Width="17" Height="17"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="System Specs" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="nav" Classes.active="{Binding IsInstalledAppsPage}"
                                    Command="{Binding NavigateCommand}" CommandParameter="apps">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <Path Data="{StaticResource GridGeometry}"
                                          StrokeThickness="1.6" StrokeLineCap="Round"
                                          Stretch="Uniform" Width="17" Height="17"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Applications" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Browser journeys need no setup; say so where the user
                                 would otherwise go looking for a switch. -->
                            <Border Background="{StaticResource RailAltBrush}"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="13,11" Margin="0,22,0,0"
                                    IsVisible="{Binding IsBrowserTracking}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Classes="pulse" Width="7" Height="7"
                                                 Fill="{StaticResource SuccessBrush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="BROWSER JOURNEYS" FontSize="9"
                                                   FontWeight="SemiBold" LetterSpacing="1.1"
                                                   Foreground="{StaticResource RailFgActiveBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Captured automatically through the OS accessibility tree — no extension, no debugger port."
                                               FontSize="10.5" TextWrapping="Wrap"
                                               Foreground="{StaticResource RailFgBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Signed-in employee + disconnect -->
                        <StackPanel Grid.Row="3" Margin="12,0,12,16" Spacing="10">
                            <Rectangle Height="1" Fill="{StaticResource RailBorderBrush}"
                                       Margin="2,0,2,6"/>

                            <StackPanel Orientation="Horizontal" Spacing="11" Margin="4,0">
                                <Border Width="36" Height="36" CornerRadius="18"
                                        Background="{Binding EmployeeAvatarColor}">
                                    <TextBlock Text="{Binding EmployeeAvatar}"
                                               Foreground="White" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding EmployeeName}"
                                               Foreground="{StaticResource RailFgActiveBrush}"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    <TextBlock Text="{Binding EmployeeRole}"
                                               Foreground="{StaticResource RailFgBrush}"
                                               FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Command="{Binding LogoutCommand}"
                                    Content="Disconnect"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="{StaticResource TransparentBrush}"
                                    Foreground="#F87171"
                                    BorderBrush="{StaticResource RailBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="10,8" FontSize="12" Cursor="Hand"/>

                            <TextBlock Text="{Binding AppVersionDisplay}"
                                       Foreground="{StaticResource RailFgBrush}" FontSize="10"
                                       Opacity="0.75" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ Content column ══ -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*">

                    <!-- Top bar -->
                    <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="26,15">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding ActivePageTitle}" Classes="h1" FontSize="20"/>
                                <TextBlock Text="{Binding ActivePageSubtitle}" Classes="label"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                        VerticalAlignment="Center">
                                <Border Classes="badge ok">
                                    <TextBlock Text="{Binding EnvironmentLabel}"/>
                                </Border>
                                <Button Classes="ghost" Command="{Binding RefreshActivePageCommand}"
                                        ToolTip.Tip="Refresh this page">
                                    <Path Data="{StaticResource RefreshGeometry}"
                                          Stroke="{StaticResource MutedFgBrush}" StrokeThickness="1.8"
                                          StrokeLineCap="Round" Stretch="Uniform"
                                          Width="15" Height="15"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Pages 4–6. Each binds to its own VM; the page-in class
                         gives the switch a transition instead of a flicker. -->
                    <Grid Grid.Row="1">
                        <pages:DashboardPage DataContext="{Binding Dashboard}"
                                             IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsDashboardPage}"/>
                        <pages:SystemSpecsPage DataContext="{Binding SystemSpecs}"
                                               IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsSystemSpecsPage}"/>
                        <pages:InstalledAppsPage DataContext="{Binding InstalledApps}"
                                                 IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsInstalledAppsPage}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
