<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:client.ViewModels"
             xmlns:conv="clr-namespace:client.Converters"
             x:Class="client.Views.Pages.LoginPage"
             x:DataType="vm:MainViewModel">

    <!-- ═══ PAGE 2 — Employee Login ═══════════════════════════════════════
         Split layout: circuit-board artwork on the left (Assets/backgrounds/
         login-hero.png), credential card on the right. The artwork column
         collapses on narrow windows so the form is never squeezed.
    ═══════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <conv:BoolInvertConverter x:Key="BoolInvert"/>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty"/>
        <conv:LoadingToTextConverter x:Key="LoadingToText"/>
    </UserControl.Resources>

    <Grid ColumnDefinitions="1.15*,1*">

        <!-- ── Left: artwork panel ── -->
        <Border Grid.Column="0" ClipToBounds="True"
                Background="{StaticResource LoginPanelBrush}"
                MinWidth="360">
            <Grid>
                <Image Source="avares://client/Assets/backgrounds/login-hero.png"
                       Stretch="UniformToFill"
                       Classes="hero-drift"
                       Opacity="0.92"/>
                <Border Background="{StaticResource HeroScrimBrush}"/>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="46,0,46,52" Spacing="14" MaxWidth="440">
                    <Border Classes="badge" Background="#2610B981" BorderBrush="#4410B981"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Classes="pulse" Width="7" Height="7" Fill="#34D399"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EnvironmentLabel}" Foreground="#A7F3D0"
                                       LetterSpacing="1.3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding AppDisplayName}"
                               FontSize="32" FontWeight="Bold" Foreground="White"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AppTagline}"
                               FontSize="11.5" FontWeight="SemiBold" LetterSpacing="2.4"
                               Foreground="#7DD3FC"/>
                    <TextBlock Text="Continuous compliance monitoring for managed workstations — hardware inventory, software inventory and session activity, encrypted end to end."
                               FontSize="13" Foreground="#C6D9EA" TextWrapping="Wrap"
                               LineHeight="20" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Right: credential card ── -->
        <Border Grid.Column="1" Background="{StaticResource CanvasBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Classes="page-in" VerticalAlignment="Center" Margin="40,48">
                    <StackPanel MaxWidth="380" HorizontalAlignment="Center" Spacing="0">

                        <Border Width="56" Height="56" CornerRadius="16"
                                Background="{StaticResource PrimarySoftBrush}"
                                HorizontalAlignment="Left">
                            <Grid>
                                <Path Data="{StaticResource ShieldGeometry}"
                                      Fill="{StaticResource PrimaryBrush}"
                                      Stretch="Uniform" Width="30" Height="30"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path Data="M8.5 12.5l2.5 2.5 5-5"
                                      Stroke="White" StrokeThickness="2.6" StrokeLineCap="Round"
                                      Width="25" Height="25"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Employee Login" Classes="h1"
                                   FontSize="26" Margin="0,20,0,4"/>
                        <TextBlock Text="Sign in with the credentials issued by your administrator."
                                   Classes="label" TextWrapping="Wrap" Margin="0,0,0,26"/>

                        <TextBlock Text="EMPLOYEE ID" Classes="eyebrow" Margin="0,0,0,7"/>
                        <TextBox Text="{Binding EmployeeId}" PlaceholderText="e.g. EMP-10001"/>

                        <TextBlock Text="SECRET KEY" Classes="eyebrow" Margin="0,18,0,7"/>
                        <!-- Masked: the secret key is a long-lived credential and must
                             never render in cleartext on a shared/observed screen. -->
                        <TextBox Text="{Binding SecretKey}"
                                 PasswordChar="●"
                                 PlaceholderText="Enter your secret key"/>

                        <Border Background="{StaticResource DangerSoftBrush}"
                                BorderBrush="{StaticResource DangerSoftBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="12,9" Margin="0,16,0,0"
                                IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource DangerSoftFgBrush}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <Button Classes="primary"
                                Command="{Binding LoginCommand}"
                                HorizontalAlignment="Stretch" Height="46"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInvert}}"
                                Content="{Binding IsLoading, Converter={StaticResource LoadingToText}}"
                                Margin="0,22,0,0" FontSize="15"/>

                        <StackPanel Orientation="Horizontal" Spacing="7"
                                    HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Path Data="{StaticResource ShieldGeometry}"
                                  Fill="{StaticResource SuccessBrush}"
                                  Stretch="Uniform" Width="12" Height="12"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Secured with AES-256-GCM end-to-end encryption"
                                       FontSize="11" Foreground="{StaticResource FaintFgBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,26,0,16"/>

                        <TextBlock Text="{Binding AppVersionDisplay}" FontSize="11"
                                   Foreground="{StaticResource FaintFgBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AppCopyright}" FontSize="10.5"
                                   Foreground="{StaticResource FaintFgBrush}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
