<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:client.ViewModels"
             xmlns:conv="clr-namespace:client.Converters"
             x:Class="client.Views.Pages.InstalledAppsPage"
             x:DataType="vm:InstalledAppsViewModel">

    <!-- ═══ PAGE 6 — Installed Applications ══════════════════════════════
         Live OS scan through the same detectors the collectors use, so
         this list matches what is reported upstream. The table is a
         virtualised ListBox — inventories run to thousands of rows.
    ═══════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="26,22,26,26">

        <!-- ── Hero band ── -->
        <Border Grid.Row="0" CornerRadius="{StaticResource RadiusLg}" ClipToBounds="True"
                Height="150" BoxShadow="{StaticResource ShadowSm}">
            <Grid>
                <Image Source="avares://client/Assets/backgrounds/apps-hero.png"
                       Stretch="UniformToFill" Classes="hero-drift"/>
                <Border Background="{StaticResource HeroScrimBrush}"/>

                <Grid Margin="30,0" VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="7">
                        <TextBlock Text="SOFTWARE INVENTORY" FontSize="10.5" FontWeight="SemiBold"
                                   LetterSpacing="1.8" Foreground="#7DD3FC"/>
                        <TextBlock Text="Installed Applications" FontSize="25" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Everything this workstation reports to the compliance server"
                                   FontSize="12.5" Foreground="#BFD5E8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <Border Classes="badge" Background="#26FFFFFF" BorderBrush="#3DFFFFFF"
                                Padding="15,9">
                            <StackPanel Spacing="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding AppCount}" Foreground="White"
                                           FontSize="19" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="APPS" Foreground="#94A9C0" FontSize="9.5"
                                           LetterSpacing="1.2" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="badge" Background="#26FFFFFF" BorderBrush="#3DFFFFFF"
                                Padding="15,9">
                            <StackPanel Spacing="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PackageCount}" Foreground="White"
                                           FontSize="19" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="PACKAGES" Foreground="#94A9C0" FontSize="9.5"
                                           LetterSpacing="1.2" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Toolbar: segmented tabs + search ── -->
        <Grid Grid.Row="1" Margin="0,18,0,14" ColumnDefinitions="Auto,*,Auto">

            <Border Grid.Column="0" Background="{StaticResource MutedBrush}"
                    CornerRadius="{StaticResource RadiusMd}" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <Button Classes="tab" Classes.active="{Binding IsAppsTab}"
                            Command="{Binding ShowAppsCommand}" Content="Applications"/>
                    <Button Classes="tab" Classes.active="{Binding IsPackagesTab}"
                            Command="{Binding ShowPackageListCommand}" Content="Packages"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="14,0" MaxWidth="380" HorizontalAlignment="Left">
                <TextBox Classes="search" Text="{Binding SearchText}"
                         PlaceholderText="Search by name, publisher or version…"
                         Padding="36,8,34,8"/>
                <Path Data="{StaticResource SearchGeometry}"
                      Stroke="{StaticResource FaintFgBrush}" StrokeThickness="1.7"
                      Stretch="Uniform" Width="14" Height="14"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="14,0,0,0" IsHitTestVisible="False"/>
                <Button Classes="ghost" Content="✕" Padding="6,2" FontSize="11"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                        Command="{Binding ClearSearchCommand}"
                        IsVisible="{Binding SearchText, Converter={StaticResource StringNotEmpty}}"/>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding LastRefreshed}" Classes="label" FontSize="11.5"
                           VerticalAlignment="Center"
                           IsVisible="{Binding LastRefreshed, Converter={StaticResource StringNotEmpty}}"/>
                <Button Classes="secondary" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding !IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Data="{StaticResource RefreshGeometry}"
                              Stroke="{StaticResource MutedFgBrush}" StrokeThickness="1.8"
                              Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Rescan" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Table ── -->
        <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- Column header -->
                <Grid Grid.Row="0" Margin="14,13" ColumnDefinitions="Auto,2.2*,1*,1.4*,Auto">
                    <TextBlock Grid.Column="1" Text="NAME" Classes="eyebrow" Margin="42,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="VERSION" Classes="eyebrow"/>
                    <TextBlock Grid.Column="3" Text="PUBLISHER" Classes="eyebrow"/>
                    <TextBlock Grid.Column="4" Text="SOURCE" Classes="eyebrow" MinWidth="82"/>
                </Grid>

                <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource BorderBrush}"/>

                <ListBox Grid.Row="2" Classes="table" ItemsSource="{Binding Items}"
                         SelectionMode="Single" IsVisible="{Binding HasResults}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:InventoryRow">
                            <Border Classes="row" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,2.2*,1*,1.4*,Auto">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                            Background="{Binding AccentColor}">
                                        <TextBlock Text="{Binding Initials}" Foreground="White"
                                                   FontSize="11.5" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" Classes="value"/>
                                        <TextBlock Text="{Binding Detail}" Classes="label mono"
                                                   FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Version}"
                                               Classes="label mono" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="3" Text="{Binding Publisher}"
                                               Classes="label" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Border Grid.Column="4" Classes="badge" VerticalAlignment="Center"
                                            MinWidth="82">
                                        <TextBlock Text="{Binding Source}" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty / scanning state -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="10" IsVisible="{Binding !HasResults}">
                    <Path Classes="spinner" Data="{StaticResource SpinnerArcGeometry}"
                          Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2.2"
                          StrokeLineCap="Round" Stretch="Uniform" Width="22" Height="22"
                          HorizontalAlignment="Center" IsVisible="{Binding IsBusy}"/>
                    <TextBlock Text="Scanning this machine…" Classes="label"
                               HorizontalAlignment="Center" IsVisible="{Binding IsBusy}"/>
                    <TextBlock Text="{Binding EmptyMessage}" Classes="label"
                               TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"
                               HorizontalAlignment="Center" IsVisible="{Binding !IsBusy}"/>
                </StackPanel>

                <!-- Footer count -->
                <Border Grid.Row="3" Background="{StaticResource RowAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <TextBlock Classes="label" FontSize="11.5">
                        <Run Text="Showing"/>
                        <Run Text="{Binding VisibleCount}" FontWeight="SemiBold"/>
                        <Run Text="entries"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
