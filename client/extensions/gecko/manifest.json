{
  "manifest_version": 3,
  "name": "Alpha AI Tracker — Browser Journey",
  "version": "1.0.0",
  "description": "Captures real-time browser navigation (URLs, tabs, titles) and sends to Alpha AI Tracker via Native Messaging.",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "alpha-ai-tracker@alphai.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Alpha AI Tracker",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "48": "icons/icon-48.svg",
      "128": "icons/icon-128.svg"
    }
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  }
}
