{
  "manifest_version": 3,
  "name": "Alpha AI Tracker — Browser Journey",
  "version": "1.0.0",
  "description": "Captures real-time browser navigation (URLs, tabs, titles) and sends to Alpha AI Tracker via Native Messaging.",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "alpha-ai-tracker@alphai.com",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
