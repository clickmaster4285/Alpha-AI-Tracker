# Alpha AI Tracker — Client Configuration
# Copy this to .env and fill in values

# Unique machine identifier (leave empty for auto-generate)
ALPHA_CLIENT_ID=

# SQLite database path (relative or absolute)
ALPHA_DB_PATH=data/alpha_tracker.db

# Encryption key for SQLite (leave empty if not encrypting)
# Use: openssl rand -hex 32
ALPHA_DB_ENCRYPTION_KEY=

# Log collection interval in seconds (default: 30)
ALPHA_COLLECT_INTERVAL_SEC=30

# Log level: Verbose, Debug, Info, Warn, Error
ALPHA_LOG_LEVEL=Info

# Server URL (for future use — leave empty for local-only mode)
ALPHA_SERVER_URL=
ALPHA_API_KEY=

# GitHub repository for releases (format: owner/repo)
REPO=AlphaDev-7/Alpha-AI-Tracker

# ─── Browser journey tracking (Option B — OS accessibility tree) ───
# Master switch. The tracker reads browser windows from the OS accessibility tree
# (AT-SPI on Linux, UI Automation on Windows, Accessibility API on macOS) — the SAME
# way screen readers see the screen. No debugger, no extension, no browser catalog
# dependency. Works on every browser and every Chrome version (incl. Chrome 136+).
ALPHA_BROWSER_TRACKING_ENABLED=true
# How often (seconds) the accessibility tree is polled for the active-tab URL/title.
ALPHA_BROWSER_ACCESSIBILITY_POLL_SECONDS=3
# Close a browser journey after this many idle minutes (window open, no URL/title change).
ALPHA_BROWSER_JOURNEY_IDLE_MINUTES=15
# Capture incognito/private-window URLs. OFF by default: recording private browsing
# requires explicit legal sign-off. When OFF, incognito windows are still detected and
# flagged in metadata, but their URL is not stored.
ALPHA_BROWSER_CAPTURE_INCOGNITO=true

# ─── Browser journey URL fallback (browser profile history DB) ───
# When the accessibility tree cannot expose the active-tab URL (Linux Chrome 136+ unless
# launched with --force-renderer-accessibility; snap Firefox is AppArmor-blocked), the
# tracker reads the browser's OWN profile history database instead (Chromium "History",
# Firefox "places.sqlite") — while the browser is running, no restart/flag/extension.
# Works on all platforms and browsers, including brand-new ones (install→use→uninstall).
# Incognito visits are never written to history DBs, so they stay out automatically.
ALPHA_BROWSER_HISTORY_ENABLED=true
# How often (seconds) browser history databases are re-scanned/re-read (default 10).
ALPHA_BROWSER_HISTORY_POLL_SECONDS=10

# ─── USB / peripheral hotplug tracking (local SQLite only) ───
# Records when physical devices (USB drives, phones, keyboards, mice, headsets,
# monitors, chargers) are plugged in / unplugged into the local hardware_devices table.
# Linux-only. Local-only for now — NOT synced to the server yet.
ALPHA_HARDWARE_DEVICES_ENABLED=true
