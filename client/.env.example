# Alpha AI Tracker — Client Configuration
# Copy this to .env and fill in values

# Unique machine identifier (leave empty for auto-generate)
ALPHA_CLIENT_ID=

# SQLite database path (relative or absolute)
ALPHA_DB_PATH=data/alpha_tracker.db

# Encryption key for SQLite (leave empty if not encrypting)
# Use: openssl rand -hex 32
ALPHA_DB_ENCRYPTION_KEY=

# Log collection interval in seconds (default: 30)
ALPHA_COLLECT_INTERVAL_SEC=30

# Log level: Verbose, Debug, Info, Warn, Error
ALPHA_LOG_LEVEL=Info

# Server URL (for future use — leave empty for local-only mode)
ALPHA_SERVER_URL=
ALPHA_API_KEY=

# GitHub repository for releases (format: owner/repo)
REPO=AlphaDev-7/Alpha-AI-Tracker

# ─── Browser journey tracking (optional, defaults shown) ───
# Master switch for the debugger-only browser journey pipeline.
ALPHA_BROWSER_TRACKING_ENABLED=true
# First port the browser debug-port allocator scans from (30000, 30001, ...).
ALPHA_BROWSER_DEBUG_PORT_START=30000
# Attach-only mode (default): never opens, relaunches, or kills a browser. Only attaches to
# browsers already running with a debug port exposed. Set to true to enable auto-launch /
# relaunch on the user's real profile (disruptive — kills the running browser to add the flag).
ALPHA_BROWSER_AUTO_LAUNCH=false

# Runtime thresholds & knobs (tune during pilot)
ALPHA_BROWSER_RUNTIME_PERSIST_THRESHOLD_SECONDS=30
ALPHA_BROWSER_EPHEMERAL_TTL_SECONDS=300
ALPHA_BROWSER_START_DEBOUNCE_SECONDS=10
ALPHA_BROWSER_JOURNEY_IDLE_MINUTES=15
ALPHA_BROWSER_MIN_MEANINGFUL_EVENTS=2
ALPHA_BROWSER_RECONNECT_BASE_SECONDS=5
ALPHA_BROWSER_RECONNECT_MAX_SECONDS=60
ALPHA_BROWSER_COORDINATOR_DEDUP_SECONDS=5
ALPHA_BROWSER_MAX_CONCURRENT_SESSIONS=0  # 0 = unlimited
# Min minutes to wait between real-profile relaunches (hijack). Guards against kill-loops.
# The tracker terminates a running browser that lacks a debug port and relaunches the SAME
# real profile with --remote-debugging-port so normal double-click browsing is tracked
# (permission granted at install). 0 = disabled (attach/dedicated-instance only).
ALPHA_BROWSER_HIJACK_COOLDOWN_MINUTES=3

