# Alpha AI Tracker — Client Configuration
# Copy this to .env and fill in values

# Unique machine identifier (leave empty for auto-generate)
ALPHA_CLIENT_ID=

# SQLite database path (relative or absolute)
ALPHA_DB_PATH=data/alpha_tracker.db

# Encryption key for SQLite (leave empty if not encrypting)
# Use: openssl rand -hex 32
ALPHA_DB_ENCRYPTION_KEY=

# Log collection interval in seconds (default: 30)
ALPHA_COLLECT_INTERVAL_SEC=30

# Log level: Verbose, Debug, Info, Warn, Error
ALPHA_LOG_LEVEL=Info

# Server URL (for future use — leave empty for local-only mode)
ALPHA_SERVER_URL=
ALPHA_API_KEY=

# GitHub repository for releases (format: owner/repo) — SET YOUR OWN, e.g. your-org/your-repo.
# Leave empty to disable the GitHub self-updater.
REPO=

# ─── Self-update from GitHub Releases ───
# The client checks https://github.com/{repo}/releases/latest for an installer newer
# than the running VERSION, downloads it into the user data dir and installs via the
# OS installer (pkexec dpkg on Linux / silent Inno Setup on Windows / dmg on macOS).
# The repo ALWAYS comes from .env — no code default. ALPHA_UPDATE_REPO wins; falls back
# to REPO= above; if both are empty the updater is disabled.
ALPHA_UPDATE_REPO=
# Master switch for ALL update behaviour (background checks + auto-install).
ALPHA_UPDATE_ENABLED=true
# Minimum hours between quiet background update checks (default 24).
ALPHA_UPDATE_AUTO_CHECK_HOURS=24
# Auto-download + install when a check finds a newer version. Linux still shows the
# polkit password dialog (the install dir is root-owned); set false to only notify.
ALPHA_UPDATE_AUTO_INSTALL=true

# ─── Browser journey tracking (Option B — OS accessibility tree) ───
# Master switch. The tracker reads browser windows from the OS accessibility tree
# (AT-SPI on Linux, UI Automation on Windows, Accessibility API on macOS) — the SAME
# way screen readers see the screen. No debugger, no extension, no browser catalog
# dependency. Works on every browser and every Chrome version (incl. Chrome 136+).
ALPHA_BROWSER_TRACKING_ENABLED=true
# How often (seconds) the accessibility tree is polled for the active-tab URL/title.
ALPHA_BROWSER_ACCESSIBILITY_POLL_SECONDS=3
# Close a browser journey after this many idle minutes (window open, no URL/title change).
ALPHA_BROWSER_JOURNEY_IDLE_MINUTES=15
# Capture incognito/private-window URLs. OFF by default: recording private browsing
# requires explicit legal sign-off. When OFF, incognito windows are still detected and
# flagged in metadata, but their URL is not stored.
ALPHA_BROWSER_CAPTURE_INCOGNITO=true

# ─── Browser journey URL fallback (browser profile history DB) ───
# When the accessibility tree cannot expose the active-tab URL (Linux Chrome 136+ unless
# launched with --force-renderer-accessibility; snap Firefox is AppArmor-blocked), the
# tracker reads the browser's OWN profile history database instead (Chromium "History",
# Firefox "places.sqlite") — while the browser is running, no restart/flag/extension.
# Works on all platforms and browsers, including brand-new ones (install→use→uninstall).
# Incognito visits are never written to history DBs, so they stay out automatically.
ALPHA_BROWSER_HISTORY_ENABLED=true
# How often (seconds) browser history databases are re-scanned/re-read (default 10).
ALPHA_BROWSER_HISTORY_POLL_SECONDS=10

# ─── USB / peripheral hotplug tracking (local SQLite only) ───
# Records when physical devices (USB drives, phones, keyboards, mice, headsets,
# monitors, chargers) are plugged in / unplugged into the local hardware_devices table.
# Linux-only. Local-only for now — NOT synced to the server yet.
ALPHA_HARDWARE_DEVICES_ENABLED=true

# ─── Software inventory — near-real-time install/uninstall detection ───
# InstalledSoftwareWatcher watches .desktop/dpkg/Start Menu, /Applications and triggers an
# immediate inventory rescan on change — install/uninstall recorded in ~2-5s, no GUI needed.
# Set to false to DISABLE real-time detection entirely (installs/uninstalls then only picked up at next boot).
ALPHA_INVENTORY_WATCH_ENABLED=true

# ─── Sync engine (dedicated SyncService loop — collection never blocks on network) ───
# SyncService drains unsent SQLite rows on its OWN background loop in chunks bounded by
# BOTH row count and payload bytes, gzips request bodies, pauses politely between chunks,
# and backs off exponentially on failure. A 50k+ backlog drains in minutes without
# spiking CPU or adding latency to collection.
# Min wait (seconds) between drain passes when idle (default 60).
ALPHA_SYNC_INTERVAL_SEC=60
# Max rows per chunk (default 1000).
ALPHA_SYNC_MAX_ROWS=1000
# Max serialized payload bytes per chunk, ~1MB (default 1000000).
ALPHA_SYNC_MAX_BYTES=1000000
# Politeness pause (ms) between chunks while draining a backlog (default 150).
ALPHA_SYNC_CHUNK_DELAY_MS=150
# Per-pass time budget (seconds); a huge backlog never monopolizes CPU (default 300).
ALPHA_SYNC_MAX_DURATION_SEC=300
# Exponential-backoff ceiling (seconds) on sync failure (default 300 = 5 min).
ALPHA_SYNC_BACKOFF_MAX_SEC=300
# gzip request bodies (default true; server must run middleware.Decompress).
ALPHA_SYNC_COMPRESSION=true
# Retention: delete synced app_items/app_sessions older than this many hours from the client
# SQLite after they've been sent to the server (default 24). Other tables: uninstalled
# inventory cycles (is_installed=0) and superseded network rows are also pruned once synced.
ALPHA_SYNC_RETENTION_HOURS=24
