<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultServerUrl Condition="'$(DefaultServerUrl)'==''">http://localhost:8080</DefaultServerUrl>
  </PropertyGroup>

  <!-- Read version from VERSION file (single source of truth).
       Evaluated at project-evaluation time (NOT in a BeforeBuild target) so that
       design-time builds from the IDE pick it up too. A target-based read is
       skipped by design-time compiles, which silently fall back to 1.0.0. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/VERSION')">
    <VersionFromFile>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/VERSION').Trim())</VersionFromFile>
    <Version>$(VersionFromFile)</Version>
    <AssemblyVersion>$(VersionFromFile).0</AssemblyVersion>
    <FileVersion>$(VersionFromFile).0</FileVersion>
    <InformationalVersion>$(VersionFromFile)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**" />
  </ItemGroup>

  <!-- APP_IDENTIFIERS is the single source of truth for app branding. Embedding it
       in the assembly lets Core/AppInfo.cs read it at runtime, so the GUI picks up
       edits on the next build with no extra wiring. Because it lives INSIDE
       client.dll it needs no installer bundling (see AGENTS.md installer parity). -->
  <ItemGroup>
    <EmbeddedResource Include="APP_IDENTIFIERS" LogicalName="client.APP_IDENTIFIERS" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DefaultServerUrl" Value="$(DefaultServerUrl)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" Condition="$(TargetFramework.Contains('-windows'))" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".env.example" CopyToOutputDirectory="Never" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Platform/Linux/alpha_atspi.py" />
  </ItemGroup>
</Project>
